# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Neon/PostgreSQL — optional until a DB-backed feature is used.
# DATABASE_URL: application connection (pooled Neon URL is acceptable).
# DIRECT_DATABASE_URL: preferred non-pooled/admin URL for Alembic migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=

# AI — mirrors the OpenAI-compatible DeepSeek boundary used in chess_repertoir_trainer.
AI_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_DEBUG_LOGGING=false

# Optional source credentials. Keep real values out of Git.
X_BEARER_TOKEN=
YOUTUBE_API_KEY=

# Structured NBA provider.
# TheSportsDB documents 123 as its public development key. Use a private/premium
# key for production-scale limits; do not commit private keys.
SPORTS_PROVIDER=thesportsdb
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
THESPORTSDB_API_KEY=123
THESPORTSDB_NBA_LEAGUE_ID=4387
SPORTS_PROVIDER_TIMEOUT_SECONDS=20
SPORTS_PROVIDER_MAX_RETRIES=2
