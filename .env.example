# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Neon/PostgreSQL — fill after the Neon project is created.
DATABASE_URL=
DIRECT_DATABASE_URL=

# AI — mirrors the OpenAI-compatible DeepSeek boundary used in chess_repertoir_trainer.
AI_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_DEBUG_LOGGING=false

# Optional source credentials. Keep real values out of Git.
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
